# Copy this file to .env and fill in real values (this file is gitignored, matching the
# repo root's own .env pattern).

# Library.Api base URL — must be HTTPS. UseHttpsRedirection() 307-redirects HTTP to
# HTTPS and strips the Authorization header on that redirect, so authenticated requests
# against the HTTP port silently come back 401.
BASE_URL=https://localhost:7282

# Seeded admin account (Library.Api/Library.Infrastructure/Data/AdminSeeder.cs), same
# credentials as the AdminSeed:Email / AdminSeed:Password user secret on Library.Api.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
