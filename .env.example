# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Postgres credentials (used by both the postgres and library-api services)
DB_NAME=librarydb2
DB_USER=postgres
DB_PASSWORD=changeme

# ASP.NET Core environment: Development or Production
ASPNETCORE_ENVIRONMENT=Development

# Swagger UI toggle — overrides the Development-only default when set
ENABLE_SWAGGER=true
