# Copy this file to .env and fill in real values. 

# Postgres credentials (used by both the postgres and library-api services)
DB_NAME=librarydb2
DB_USER=postgres
DB_PASSWORD=changeme

# ASP.NET Core environment: Development or Production
ASPNETCORE_ENVIRONMENT=Development

# Swagger UI toggle — overrides the Development-only default when set
ENABLE_SWAGGER=true

Jwt__SigningKey=YourProductionSuperSecretKeyHere1234567890!

# Keycloak admin console bootstrap login (local dev only) — also used by
# scripts/test-endpoints.ps1 to call the Keycloak Admin REST API for test-user setup
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
